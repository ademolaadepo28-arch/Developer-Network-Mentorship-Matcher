{
  "name": "developer-network-mentorship-matcher",
  "version": "1.0.0",
  "description": "Automated Pairing Platform via Public GitHub Activity & Vector Profiles",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm --workspace=client run build && npm --workspace=server run build",
    "start": "npm --workspace=server run start",
    "test": "npm --workspace=server run test",
    "seed": "npm --workspace=server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
